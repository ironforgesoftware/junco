# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtualenvs
.venv/
venv/
env/

# Operational artifacts (junco creates these at runtime)
launchd.out
launchd.err
worker.lock
worktrees/
worktrees-manual/

# Ticket state (inbox/processing/done/failed, worker.log). Per-run state under
# the configured vault; do not commit.
tickets/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp
*~

# Local coverage / build outputs
htmlcov/
.coverage
.coverage.*
dist/
build/
*.egg-info/

# Node / TypeScript (M1+ rewrite)
node_modules/
*.tsbuildinfo

# Personal runtime config (machine-specific). The shipped template is examples/config.json.
/config.json
/config.toml
