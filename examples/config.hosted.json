{
  "dataDir": "~/.junco",
  "updateCheck": true,
  "tools": ["read", "bash", "edit", "write", "grep", "find", "ls"],
  "worker": {
    "commitLeftovers": false,
    "defaultTimeoutMinutes": 30,
    "pollIntervalSeconds": 15,
    "startupPollSeconds": 30,
    "startupWait": true,
    "maxTransientRetries": 2,
    "retryBackoffSeconds": 60,
    "maxConcurrent": 1,
    "applyFallbackToAgent": true,
    "dailyBudgetUsd": 5
  },
  "model": {
    "id": "anthropic/claude-sonnet-4-5"
  },
  "supervisor": {
    "enabled": true,
    "budgetPerKind": 1,
    "escalationWindowTurns": 3,
    "outputBudgetPerTurn": 12000,
    "outputBudgetPostCommit": 24000
  },
  "git": {
    "gitBin": "git",
    "ghBin": "gh",
    "defaultBaseBranch": "main",
    "branchPrefix": "junco/",
    "removeWorktreeOnSuccess": true,
    "allowedRepoRoots": []
  },
  "pr": {
    "draftByDefault": true,
    "defaultLabels": []
  },
  "verify": {
    "enabled": true,
    "commandTimeout": 60,
    "blockOnFail": false
  },
  "sandbox": {
    "enabled": true,
    "backend": "auto",
    "network": "deny",
    "extraDenyRead": [],
    "extraAllowWrite": [],
    "bashTimeoutSeconds": 600
  },
  "critic": {
    "enabled": true,
    "maxRetries": 1,
    "thinking": "minimal"
  },
  "planLint": {
    "enabled": true,
    "blockOnError": true,
    "checkLabels": true
  },
  "observability": {
    "healthEnabled": true,
    "healthHost": "127.0.0.1",
    "healthPort": 8787,
    "logLevel": "info",
    "logToFile": true,
    "transcripts": true
  },
  "github": {
    "enabled": false,
    "triggerLabel": "junco",
    "pollIntervalSeconds": 60,
    "requireApproval": true,
    "repos": []
  },
  "botAccount": {
    "enabled": false,
    "configDir": "~/.junco/gh"
  },
  "planSets": {
    "enabled": false,
    "mergePollSeconds": 60,
    "maxTasks": 10
  },
  "assess": {
    "maxIssuesPerRun": 20,
    "minSeverity": "low",
    "npmBin": "npm"
  },
  "skills": {
    "harnessDirs": []
  }
}
